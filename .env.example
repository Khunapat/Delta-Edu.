# Delta Edu bot settings. Copy to .env in ~/delta-edu (never commit .env).
# Never reuse the Norse .env: Delta Edu has its own LINE channel, Sheet and service.
# ---- LINE Messaging API (LINE Developers Console > your channel) ----
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ---- Team Google Sheet ----
# The ID from the Sheet URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
# Whoever owns the Sheet shares it (Editor) with the bot's service account:
#   delta-edu-bot@<your-project>.iam.gserviceaccount.com
SHEET_ID=
# First start only, when the Members tab is empty. Nick/alias/alias:role.
# Aliases are other spellings people type (short forms). Admin(s) marked with :admin;
# other roles (founder, tutor) are labels.
TEAM_SEED=Best:founder, Jai:admin, Kiak:tutor, Pure

# ---- AI ----
# Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Tried in order; each model's free quota is counted separately.
# Check AI Studio > Rate limits for the current free models and change this list.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3-flash,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Optional, paid. Used instead of Gemini when LLM_PROVIDER=anthropic (or no Gemini key).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
LLM_PROVIDER=

BOT_NAME=Delta
TIMEZONE=Asia/Bangkok

# ---- Web board at /board (the team dashboard), optional ----
# LINE Login channel in the SAME provider as the bot + a LIFF app pointing at https://<service>/board
LINE_LOGIN_CHANNEL_ID=
LIFF_ID=
# Signs the board's login cookie. setup.sh makes one.
SESSION_SECRET=

# ---- Schedule (hours in TIMEZONE) ----
CRON_SECRET=
MORNING_HOUR=8
EVENING_HOUR=18
MONDAY_HOUR=9
FRIDAY_HOUR=17
REMINDER_DAYS=5,3,1
OVERDUE_TAG_AFTER_DAYS=2
# LINE free plan (Thailand): 300 pushes/month, counted per person reached
PUSH_MONTHLY_LIMIT=300
